# Copy to cre/.env (git-ignored); the CRE CLI reads it from this folder. Never commit the real file.

# Only needed for --broadcast: the 64-hex-char private key of an account holding Arc testnet USDC for gas
# (0x prefix optional). Dry runs work with this placeholder: the CLI swaps in a throwaway key.
CRE_ETH_PRIVATE_KEY=your-eth-private-key
